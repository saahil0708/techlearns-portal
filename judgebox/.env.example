# ==============================================================================
# JUDGEBOX VM ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL Connection String (Azure Database for PostgreSQL Flexible Server)
DATABASE_URL="postgresql://<admin_user>:<password>@<your-postgres-server>.postgres.database.azure.com:5432/codeplatform?schema=public&sslmode=require"

# Azure Service Bus Connection String & Queue Name
AZURE_SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://<your-servicebus-namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<your-key>"
AZURE_SERVICE_BUS_QUEUE_NAME="submissions"

# Worker Performance & Sandbox Settings
MAX_CONCURRENT_JOBS=5
JUDGE_IMAGE="codeplatform-judge:latest"
JUDGE_SETUP_TIMEOUT_MS=5000
JUDGE_COMPILED_SETUP_TIMEOUT_MS=10000

# Docker Registry (if pulling from Azure Container Registry)
ACR_LOGIN_SERVER="<your-acr-name>.azurecr.io"
IMAGE_TAG="latest"
