NODE_ENV=development
PORT=8000

# Database (Host Local & Docker Compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/codeplatform?schema=public"
DOCKER_DATABASE_URL="postgresql://postgres:postgres@postgres:5432/codeplatform?schema=public"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# Authentication
JWT_SECRET="super-secret-development-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="1d"
TOTP_ENCRYPTION_KEY="replace-with-a-dedicated-32-byte-secret"
TOTP_PREVIOUS_ENCRYPTION_KEYS=""

# Azure Service Bus (Cloud & Microservices Queue)
AZURE_SERVICE_BUS_CONNECTION_STRING="Endpoint=sb://<your-servicebus-namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<your-key>"
AZURE_SERVICE_BUS_QUEUE_NAME="submissions"

# In-Memory Cache (Zero Redis Required - L1 In-Memory with Stampede Locking)
CACHE_TTL_SECONDS=300

# Azure Blob Storage (Optional for Media/Avatars)
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="techlearns-uploads"
AZURE_STORAGE_ACCOUNT_NAME=""
