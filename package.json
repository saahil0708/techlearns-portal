
{
  "name": "codeplatform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "dev": "pnpm --parallel --filter server --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm --recursive build",
    "build:server": "pnpm --filter server build",
    "build:client": "pnpm --filter client build",
    "start": "pnpm --filter server start:prod",
    "lint": "oxlint server/src client/src",
    "test": "pnpm --filter server test",
    "test:e2e": "pnpm --filter server test:e2e",
    "prisma:generate": "pnpm --filter server prisma:generate",
    "prisma:migrate": "pnpm --filter server prisma:migrate",
    "prisma:seed": "pnpm --filter server prisma:seed",
    "prisma:studio": "pnpm --filter server prisma:studio"
  },
  "devDependencies": {
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2"
  }
}
