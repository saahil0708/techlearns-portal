NODE_ENV=development
PORT=8000

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codeplatform?schema=public"

# Authentication
JWT_SECRET="super-secret-development-jwt-key-replace-in-production-min-32-chars"
JWT_EXPIRES_IN="1d"
TOTP_ENCRYPTION_KEY="replace-with-a-dedicated-32-byte-secret"
TOTP_PREVIOUS_ENCRYPTION_KEYS=""

# Azure Service Bus (Judge Queue Microservice)
# Leave empty for local fallback development mode
AZURE_SERVICE_BUS_CONNECTION_STRING=""
AZURE_SERVICE_BUS_QUEUE_NAME="submissions"

# Judge Worker Microservice Settings
MAX_CONCURRENT_JOBS=5
JUDGE_IMAGE=codeplatform-judge:latest
JUDGE_SETUP_TIMEOUT_MS=5000
JUDGE_COMPILED_SETUP_TIMEOUT_MS=10000

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER_NAME="techlearns-uploads"
AZURE_STORAGE_ACCOUNT_NAME="techlearnsstorage01"

# Mail (Local Dev or SMTP)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="CodePlatform <no-reply@codeplatform.local>"
MAIL_DEV_MODE=true

# Firebase Admin
FIREBASE_PROJECT_ID="techlearns-portal-22ff4"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
