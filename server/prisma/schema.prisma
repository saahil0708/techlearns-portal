datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ------------------------------------------------------
// ENUMS
// ------------------------------------------------------

enum Role {
  SUPER_ADMIN
  PLATFORM_ADMIN
  INSTITUTION_ADMIN
  FACULTY
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum InstitutionStatus {
  ACTIVE
  INACTIVE
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum ProblemDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgrammingLanguage {
  CPP
  JAVA
  PYTHON
  JAVASCRIPT
  C
}

enum SubmissionStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

enum SubmissionVerdict {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  RUNTIME_ERROR
  COMPILATION_ERROR
  SYSTEM_ERROR
}

enum ContestStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

// ------------------------------------------------------
// MODELS
// ------------------------------------------------------

model User {
  id                     String     @id @default(uuid())
  email                  String     @unique
  passwordHash           String
  name                   String
  globalRole             Role       @default(STUDENT)
  status                 UserStatus @default(ACTIVE)
  twoFactorEnabled       Boolean    @default(false)
  twoFactorSecret        String?
  twoFactorRecoveryCodes String[]   @default([])
  avatarUrl              String?
  bannerUrl              String?
  bio                    String?    @db.Text
  phone                  String?
  institution            String?
  department             String?
  specialization         String?
  officeHours            String?
  location               String?
  birthDate              String?
  githubUrl              String?
  linkedinUrl            String?
  websiteUrl             String?
  resumeUrl              String?
  resumeFileName         String?
  rollNo                 String?
  contestRating          Int        @default(1500)
  ratingTier             String     @default("Novice")
  createdAt              DateTime   @default(now())
  updatedAt              DateTime   @updatedAt

  memberships          InstitutionMembership[]
  batchEnrollments     BatchStudent[]
  createdCourses       Course[]              @relation("CourseCreator")
  enrollments          Enrollment[]
  lessonProgress       LessonProgress[]
  createdProblems      Problem[]             @relation("ProblemCreator")
  submissions          Submission[]
  createdContests      Contest[]             @relation("ContestCreator")
  contestRegistrations ContestRegistration[]
  leaderboardEntries   LeaderboardEntry[]
  passkeys             PasskeyCredential[]
  refreshTokens        RefreshToken[]
  twoFactorChallenges  TwoFactorChallenge[]
  auditLogs            AuditLog[]
  skillOsWorkspace     SkillOsWorkspace?
  createdBootcamps     Bootcamp[]            @relation("BootcampCreator")
  bootcampEnrollments  BootcampEnrollment[]

  @@index([globalRole, status])
  @@index([status, createdAt])
  @@index([name])
  @@map("users")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  detail    String?  @db.Text
  ipAddress String?
  status    String   @default("SUCCESS")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("audit_logs")
}

model PasskeyCredential {
  id           String    @id @default(uuid())
  userId       String
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  deviceType   String?
  backedUp     Boolean   @default(false)
  name         String? // e.g. "MacBook Touch ID", "YubiKey 5C NFC", "Windows Hello"
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkey_credentials")
}

model WebAuthnChallenge {
  id        String   @id @default(uuid())
  key       String   @unique
  challenge String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("webauthn_challenges")
}

model TwoFactorChallenge {
  id        String   @id @default(uuid())
  jti       String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("two_factor_challenges")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique
  family     String // UUID for token family tracking (reuse detection)
  isRevoked  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  deviceInfo String?
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, family])
  @@index([userId, isRevoked])
  @@map("refresh_tokens")
}

model UserInvitation {
  id            String   @id @default(uuid())
  email         String
  name          String
  role          Role     @default(STUDENT)
  institutionId String?
  batchId       String?
  rollNo        String?
  tokenHash     String   @unique
  expiresAt     DateTime
  acceptedAt    DateTime?
  revokedAt     DateTime?
  createdAt     DateTime @default(now())
  delivery      InvitationDelivery?

  @@index([email, expiresAt])
  @@index([institutionId, expiresAt])
  @@index([batchId, expiresAt])
  @@map("user_invitations")
}

model InvitationDelivery {
  id            String         @id @default(uuid())
  invitationId  String         @unique
  email         String
  activationUrl String?
  status        String         @default("PENDING")
  createdAt     DateTime       @default(now())
  claimedAt     DateTime?                                 // when a delivery is claimed for processing
  attempts      Int            @default(0)               // number of processing attempts
  updatedAt     DateTime       @updatedAt               // automatically updated on any change

  invitation UserInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("invitation_deliveries")
}

model Institution {
  id        String            @id @default(uuid())
  name      String
  code      String            @unique
  email     String?
  phone     String?
  address   String?
  tier      String?           @default("Standard Academic")
  quota     Int               @default(100)
  status    InstitutionStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  memberships InstitutionMembership[]
  batches     Batch[]
  courses     Course[]
  problems    Problem[]
  contests    Contest[]
  bootcamps   Bootcamp[]

  @@index([status, createdAt])
  @@map("institutions")
}

model InstitutionMembership {
  id            String   @id @default(uuid())
  userId        String
  institutionId String
  role          Role     @default(STUDENT)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
  @@index([institutionId, role])
  @@index([userId, role])
  @@map("institution_memberships")
}

model Batch {
  id            String    @id @default(uuid())
  name          String
  institutionId String
  maxCapacity   Int       @default(100)
  startDate     DateTime?
  endDate       DateTime?
  status        String    @default("ACTIVE")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  students    BatchStudent[]

  @@index([institutionId, status])
  @@map("batches")
}

model BatchStudent {
  id         String   @id @default(uuid())
  batchId    String
  userId     String
  rollNo     String?
  enrolledAt DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([batchId, userId])
  @@index([userId])
  @@index([batchId])
  @@map("batch_students")
}

model Course {
  id            String       @id @default(uuid())
  title         String
  description   String?      @db.Text
  institutionId String?
  createdById   String
  status        CourseStatus @default(DRAFT)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy   User         @relation("CourseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  modules     Module[]
  enrollments Enrollment[]

  @@index([institutionId, status])
  @@index([createdById, status])
  @@index([status, createdAt])
  @@map("courses")
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
  @@map("modules")
}

model Lesson {
  id        String   @id @default(uuid())
  moduleId  String
  title     String
  content   String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([moduleId, order])
  @@map("lessons")
}

model Enrollment {
  id          String           @id @default(uuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId, status])
  @@index([courseId, status])
  @@map("enrollments")
}

model LessonProgress {
  id          String    @id @default(uuid())
  userId      String
  lessonId    String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completed])
  @@index([lessonId, completed])
  @@map("lesson_progress")
}

model Problem {
  id            String            @id @default(uuid())
  title         String
  slug          String            @unique
  statement     String            @db.Text
  inputFormat   String            @db.Text
  outputFormat  String            @db.Text
  constraints   String            @db.Text
  difficulty    ProblemDifficulty @default(MEDIUM)
  timeLimit     Int               @default(1000) // ms
  memoryLimit   Int               @default(256) // MB
  institutionId String?
  createdById   String
  status        ProblemStatus     @default(DRAFT)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  institution     Institution?     @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy       User             @relation("ProblemCreator", fields: [createdById], references: [id], onDelete: Restrict)
  testCases       TestCase[]
  submissions     Submission[]
  contestProblems ContestProblem[]
  potdAssignments ProblemOfTheDay[]

  @@index([difficulty, status])
  @@index([institutionId, status])
  @@index([createdById, status])
  @@index([status, createdAt])
  @@map("problems")
}

model TestCase {
  id             String   @id @default(uuid())
  problemId      String
  input          String   @db.Text
  expectedOutput String   @db.Text
  isHidden       Boolean  @default(true)
  explanation    String?  @db.Text
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([problemId, isHidden, order])
  @@map("test_cases")
}

model Submission {
  id              String               @id @default(uuid())
  userId          String
  problemId       String
  contestId       String?
  language        ProgrammingLanguage
  sourceCode      String               @db.Text
  status          SubmissionStatus     @default(QUEUED)
  verdict         SubmissionVerdict?
  runtime         Int? // in milliseconds
  memory          Int? // in kilobytes
  errorMessage    String?              @db.Text
  passedTestCases Int                  @default(0)
  totalTestCases  Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([problemId, verdict])
  @@index([contestId, status])
  @@index([status, createdAt])
  @@map("submissions")
}

model Contest {
  id            String        @id @default(uuid())
  title         String
  description   String?       @db.Text
  startTime     DateTime
  endTime       DateTime
  institutionId String?
  createdById   String
  status        ContestStatus @default(UPCOMING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  institution        Institution?          @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy          User                  @relation("ContestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  problems           ContestProblem[]
  registrations      ContestRegistration[]
  submissions        Submission[]
  leaderboardEntries LeaderboardEntry[]

  @@index([status, startTime, endTime])
  @@index([institutionId, status])
  @@index([createdById, status])
  @@map("contests")
}

model ContestProblem {
  id        String @id @default(uuid())
  contestId String
  problemId String
  points    Int    @default(100)
  order     Int    @default(0)

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([contestId, problemId])
  @@index([contestId, order])
  @@map("contest_problems")
}

model ContestRegistration {
  id           String   @id @default(uuid())
  contestId    String
  userId       String
  registeredAt DateTime @default(now())

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([contestId, registeredAt])
  @@index([userId])
  @@map("contest_registrations")
}

model LeaderboardEntry {
  id        String   @id @default(uuid())
  contestId String
  userId    String
  score     Int      @default(0)
  penalty   Int      @default(0)
  rank      Int      @default(0)
  updatedAt DateTime @updatedAt

  contest Contest @relation(fields: [contestId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contestId, userId])
  @@index([contestId, score, penalty])
  @@index([userId])
  @@map("leaderboard_entries")
}

model ProblemOfTheDay {
  id          String   @id @default(uuid())
  date        String   @unique // Strict YYYY-MM-DD format
  problemId   String
  bonusPoints Int      @default(50)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([date])
  @@map("problem_of_the_day")
}

model SkillOsWorkspace {
  id                 String   @id @default(uuid())
  userId             String   @unique
  corporateId        String   @unique
  corporateEmail     String   @unique
  trackCode          String   @default("DEV")
  trackName          String   @default("Generative AI & Full Stack CEL Sprint")
  
  // GitHub Integration State
  githubUsername     String?
  githubTeamName     String?  @default("@techlearns-cel/sprint-alpha")
  githubAssignedRepo String?  @default("https://github.com/techlearns-cel/genai-live-sprint")
  githubInviteStatus String   @default("invited") // invited, accepted, active
  
  // Jira Integration State
  jiraAccountId      String?
  jiraBoardUrl       String?  @default("https://jira.techlearns.in/secure/RapidBoard.jspa?rapidView=14")
  jiraActiveSprint   String?  @default("Active Sprint 04")
  
  // Cloud Web IDE & Sandbox
  webIdeUrl          String?
  containerStatus    String   @default("ready") // ready, starting, stopped
  
  // Skill Passport Telemetry
  passportScore      Int      @default(0)
  prsMerged          Int      @default(0)
  jiraPointsBurned   Int      @default(0)
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([corporateId])
  @@map("skillos_workspaces")
}

model Bootcamp {
  id               String               @id @default(uuid())
  slug             String               @unique
  title            String
  subtitle         String?              @db.Text
  description      String?              @db.Text
  track            String               @default("GenAI & LLMs") // "GenAI & LLMs", "Full Stack", "System Design", "Cloud & DevOps", "Cybersecurity", "Data Engineering"
  instructor       String
  instructorRole   String?              @default("Principal Architect")
  instructorAvatar String?
  duration         String               @default("6 Weeks")
  level            String               @default("Intermediate") // "Beginner", "Intermediate", "Advanced"
  badge            String?              // "Top Rated", "CEL Featured", "Industry Flagship", "Live Sprint"
  rating           Float                @default(4.9)
  maxSeats         Int                  @default(100)
  enrolledCount    Int                  @default(0)
  totalSessions    Int                  @default(12)
  status           String               @default("PUBLISHED") // "DRAFT", "PUBLISHED", "UPCOMING", "ONGOING", "COMPLETED", "ARCHIVED"
  startDate        DateTime?
  endDate          DateTime?
  nextSessionDate  DateTime?
  nextSessionTopic String?
  syllabus         Json?                // Array of { week, topic, deliverables }
  institutionId    String?
  createdById      String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  institution      Institution?         @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdBy        User                 @relation("BootcampCreator", fields: [createdById], references: [id], onDelete: Restrict)
  sessions         BootcampSession[]
  enrollments      BootcampEnrollment[]

  @@index([track, status])
  @@index([institutionId, status])
  @@index([createdById, status])
  @@index([status, createdAt])
  @@map("bootcamps")
}

model BootcampSession {
  id            String    @id @default(uuid())
  bootcampId    String
  title         String
  description   String?   @db.Text
  sessionNumber Int       @default(1)
  startsAt      DateTime?
  endsAt        DateTime?
  meetUrl       String?
  recordingUrl  String?
  isLive        Boolean   @default(false)
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bootcamp      Bootcamp  @relation(fields: [bootcampId], references: [id], onDelete: Cascade)

  @@index([bootcampId, order])
  @@map("bootcamp_sessions")
}

model BootcampEnrollment {
  id                String    @id @default(uuid())
  userId            String
  bootcampId        String
  status            String    @default("ACTIVE") // "ACTIVE", "COMPLETED", "DROPPED"
  progressPct       Int       @default(0)
  sessionsCompleted Int       @default(0)
  enrolledAt        DateTime  @default(now())
  completedAt       DateTime?

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bootcamp          Bootcamp  @relation(fields: [bootcampId], references: [id], onDelete: Cascade)

  @@unique([userId, bootcampId])
  @@index([userId, status])
  @@index([bootcampId, status])
  @@map("bootcamp_enrollments")
}

